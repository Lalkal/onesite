{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/storage/(.*)",
      "status": 403,
      "dest": "/index.html"
    },
    {
      "src": "/database/(.*)",
      "status": 403,
      "dest": "/index.html"
    },
    {
      "src": "/src/(.*)",
      "status": 403,
      "dest": "/index.html"
    },
    {
      "src": "/bootstrap.php",
      "status": 403,
      "dest": "/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/verify(\\.php)?",
      "dest": "/api/verify.php"
    },
    {
      "src": "/download(\\.php)?",
      "dest": "/api/download.php"
    },
    {
      "src": "/admin",
      "dest": "/api/admin/index.php"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api/admin/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
