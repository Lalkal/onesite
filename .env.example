# LOGANX Automated Email Verification & Download Delivery System
# Environment Configuration Template

# Application Environment & Base URL
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# Database Configuration (MySQL / MariaDB or Supabase PostgreSQL)
# For local MySQL/XAMPP: DB_CONNECTION=mysql, DB_HOST=127.0.0.1, DB_PORT=3306
# For Supabase PostgreSQL: DB_CONNECTION=pgsql, DB_HOST=db.your-project.supabase.co, DB_PORT=5432, DB_DATABASE=postgres, DB_USERNAME=postgres, DB_PASSWORD=your-password
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loganx_downloads
DB_USERNAME=root
DB_PASSWORD=
DB_SSL=false

# Supabase Storage Bucket Configuration
# Connects the CMS directly to your Supabase Storage bucket for digital download storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=supabase-coral-bucket

# SMTP Configuration (PHPMailer)
SMTP_HOST=smtp.yourmailserver.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=downloads@yourdomain.com
SMTP_FROM_NAME="LOGANX Team"

# Token Lifespan & Download Policy
VERIFICATION_TOKEN_TTL_MINUTES=30
DOWNLOAD_TOKEN_TTL_HOURS=24
DEFAULT_DOWNLOAD_LIMIT=5

# Protected Storage Directory (fallback local path)
DOWNLOAD_STORAGE_PATH=storage/downloads

# Rate Limiting & Cooldowns
RATE_LIMIT_COOLDOWN_SECONDS=60
RATE_LIMIT_MAX_PER_HOUR=10

# Admin Panel Credentials (Default: admin / Admin@LoganX2026!)
# To generate a new password hash: php -r "echo password_hash('YourPassword', PASSWORD_BCRYPT);"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2y$12$K1qg0y0t5YgYy/48aZc2aO7pP.50KzZf6X4tF4qC6F1k0K3A9C8D2
